<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Gary Brewer</Authors>
    <Company>BuiltWith Pty Ltd</Company>
    <Description>C# client SDK for the BuiltWith API - technology lookup, domain intelligence, and more.</Description>
    <Copyright>Copyright (c) BuiltWith Pty Ltd</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/builtwith/BuiltWith-C-Client-API</PackageProjectUrl>
    <PackageIcon>newLogoSquare.png</PackageIcon>
    <RepositoryUrl>https://github.com/builtwith/BuiltWith-C-Client-API</RepositoryUrl>
    <Version>2.0.1</Version>
    <FileVersion>2.0.1.0</FileVersion>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="newLogoSquare.png" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
